<?xml version="1.0" encoding="UTF-8"?>
<!--
 * Plugin Hosteleria: asientos de los cierres Z del TPV (asientos con documento = "Z-...").
 * En el modo por defecto de la app («solo descuadre») solo hay asiento cuando la caja no cuadra y
 * su importe es el descuadre (la ayuda del pie lo explica).
-->
<view>
    <columns>
        <column name="id" display="none" order="90">
            <widget type="text" fieldname="idasiento"/>
        </column>
        <column name="number" order="100">
            <widget type="text" fieldname="numero"/>
        </column>
        <column name="tpv-z-closure" order="110">
            <widget type="text" fieldname="documento"/>
        </column>
        <column name="exercise" order="120">
            <widget type="select" fieldname="codejercicio">
                <values source="ejercicios" fieldcode="codejercicio" fieldtitle="nombre"/>
            </widget>
        </column>
        <column name="accounting-concept" order="130">
            <widget type="text" fieldname="concepto"/>
        </column>
        <column name="amount" display="right" order="140">
            <widget type="money" fieldname="importe">
                <option color="danger">lt:0</option>
            </widget>
        </column>
        <column name="date" display="right" order="150">
            <widget type="date" fieldname="fecha"/>
        </column>
    </columns>
    <rows>
        <row type="status">
            <option color="warning" title="non-editable-accounting-entry" fieldname="editable">0</option>
        </row>
        <row type="footer">
            <group name="tpv-help" numcolumns="12" label="tpv-z-closures-help"/>
        </row>
    </rows>
</view>
