<?xml version="1.0" encoding="UTF-8"?>
<!--
 * Plugin Hosteleria: listado general de escandallos.
 * Plato e ingrediente enlazan a la ficha del producto; la fila, a la ficha de la línea.
-->
<view>
    <columns>
        <column name="id" display="none" order="90">
            <widget type="text" fieldname="id"/>
        </column>
        <column name="dish" title="tpv-dish" order="100">
            <widget type="variante" fieldname="ref_plato" match="referencia" onclick="EditProducto"/>
        </column>
        <column name="ingredient" title="tpv-ingredient" order="110">
            <widget type="variante" fieldname="ref_ingrediente" match="referencia" onclick="EditProducto"/>
        </column>
        <column name="ingredient-description" title="description" order="120">
            <widget type="text" fieldname="ingrediente_descripcion"/>
        </column>
        <column name="net-quantity" title="tpv-net-quantity" display="right" order="130">
            <widget type="number" fieldname="cantidad" decimal="3"/>
        </column>
        <column name="waste" title="tpv-waste-pct" display="right" order="140">
            <widget type="number" fieldname="merma" decimal="2">
                <option color="warning">gt:0</option>
            </widget>
        </column>
        <column name="gross-quantity" title="tpv-gross-quantity" display="right" order="150">
            <widget type="number" fieldname="cantidad_bruta" decimal="3"/>
        </column>
        <column name="unit-cost" title="tpv-unit-cost" display="right" order="160">
            <widget type="money" fieldname="coste_unitario"/>
        </column>
        <column name="line-cost" title="tpv-line-cost" display="right" order="170">
            <widget type="money" fieldname="coste_linea"/>
        </column>
        <column name="observations" order="180">
            <widget type="text" fieldname="observaciones"/>
        </column>
        <column name="updated" title="tpv-updated" display="right" order="190">
            <widget type="datetime" fieldname="actualizado"/>
        </column>
    </columns>
    <rows>
        <row type="status">
            <option color="warning" title="tpv-ingredient-without-cost" fieldname="coste_origen">sin-coste</option>
        </row>
    </rows>
</view>
