<?xml version="1.0" encoding="UTF-8"?>
<!--
 * Plugin Hosteleria: consumo de materias primas por referencia y almacén en el periodo filtrado,
 * sumado del diario de stock del TPV (Model/Join/TpvConsumo). Las cantidades van en la unidad en
 * que se lleva el stock de cada producto, por eso solo se totaliza el valor.
-->
<view>
    <columns>
        <column name="reference" order="100">
            <widget type="text" fieldname="referencia"/>
        </column>
        <column name="description" order="110">
            <widget type="text" fieldname="descripcion" onclick="EditProducto" fieldclick="idproducto"/>
        </column>
        <column name="warehouse" order="120">
            <widget type="select" fieldname="codalmacen">
                <values source="almacenes" fieldcode="codalmacen" fieldtitle="nombre"/>
            </widget>
        </column>
        <column name="tpv-consumed" display="right" order="130">
            <widget type="number" fieldname="consumo" decimal="3"/>
        </column>
        <column name="tpv-returned" display="right" order="140">
            <widget type="number" fieldname="devuelto" decimal="3"/>
        </column>
        <column name="tpv-net-consumption" display="right" order="150">
            <widget type="number" fieldname="neto" decimal="3"/>
        </column>
        <column name="tpv-unit-cost" display="right" order="160">
            <widget type="money" fieldname="coste" decimal="4" totals="false"/>
        </column>
        <column name="tpv-consumption-value" display="right" order="170">
            <widget type="money" fieldname="valor"/>
        </column>
        <column name="tpv-movements" display="right" order="180">
            <widget type="number" fieldname="movimientos" decimal="0"/>
        </column>
    </columns>
    <rows>
        <row type="status">
            <option color="warning" title="tpv-reference-deleted" fieldname="idproducto">null:</option>
            <option color="secondary" title="tpv-not-deducted-nostock" fieldname="nostock">1</option>
        </row>
    </rows>
</view>
