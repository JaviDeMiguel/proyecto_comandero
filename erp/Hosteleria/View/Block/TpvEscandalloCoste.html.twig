{#
 * Plugin Hosteleria: resumen de coste teórico y margen de las variantes del producto que tienen receta.
 * Datos: settings.tpvCoste de la vista EditTpvEscandalloProducto (Extension/Controller/EditProducto).
#}
{% set tpvView = fsc.views['EditTpvEscandalloProducto'] ?? null %}
{% set tpvCoste = tpvView is not null ? (tpvView.settings['tpvCoste'] ?? []) : [] %}
{% if tpvCoste is empty %}
    <p class="text-muted mb-0">{{ trans('tpv-recipe-empty') }}</p>
{% else %}
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
            <thead>
            <tr>
                <th scope="col">{{ trans('tpv-dish') }}</th>
                <th scope="col">{{ trans('description') }}</th>
                <th scope="col" class="text-end">{{ trans('tpv-recipe-lines') }}</th>
                <th scope="col" class="text-end">{{ trans('tpv-theoretical-cost') }}</th>
                <th scope="col" class="text-end">{{ trans('tpv-cost-in-product') }}</th>
                <th scope="col" class="text-end">{{ trans('tpv-price-without-tax') }}</th>
                <th scope="col" class="text-end">{{ trans('margin') }}</th>
                <th scope="col" class="text-end">{{ trans('tpv-margin-pct') }}</th>
                <th scope="col" class="text-end">{{ trans('tpv-cost-pct') }}</th>
            </tr>
            </thead>
            <tbody>
            {% for item in tpvCoste %}
                {% set perdidas = item.margen is not null and item.margen < 0 %}
                {% set css = item.invalida or perdidas ? 'table-danger' : (item.completo ? '' : 'table-warning') %}
                <tr class="{{ css }}">
                    <td>{{ item.referencia }}</td>
                    <td>{{ item.descripcion }}</td>
                    <td class="text-end">{{ item.lineas }}</td>
                    <td class="text-end">
                        {{ item.invalida ? '-' : item.coste_txt }}{% if not item.completo and not item.invalida %} *{% endif %}
                    </td>
                    <td class="text-end">{{ item.coste_ficha_txt }}</td>
                    <td class="text-end">{{ item.precio > 0 ? money(item.precio) : '-' }}</td>
                    <td class="text-end">{{ item.margen is null ? '-' : money(item.margen) }}</td>
                    <td class="text-end">{{ item.margen_pct is null ? '-' : number(item.margen_pct, 2) ~ ' %' }}</td>
                    <td class="text-end">{{ item.coste_pct is null ? '-' : number(item.coste_pct, 2) ~ ' %' }}</td>
                </tr>
                {% if item.invalida %}
                    <tr class="table-danger">
                        <td colspan="9" class="small">
                            <i class="fa-solid fa-circle-xmark fa-fw" aria-hidden="true"></i>
                            {{ trans('tpv-recipe-invalid-help') }}
                        </td>
                    </tr>
                {% elseif item.sin_coste is not empty %}
                    <tr class="table-warning">
                        <td colspan="9" class="small">
                            <i class="fa-solid fa-triangle-exclamation fa-fw" aria-hidden="true"></i>
                            {{ trans('tpv-ingredients-without-cost', {'%refs%': item.sin_coste|join(', ')}) }}
                        </td>
                    </tr>
                {% endif %}
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% if tpvView.settings['tpvCopiarCoste'] ?? false %}
        {# este bloque se pinta dentro del formulario de la cabecera de la vista (action + activetab) #}
        {{ formToken() }}
        <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
            <button type="submit" name="action" value="tpv-copy-cost" class="btn btn-sm btn-info"
                    onclick="return confirm(this.dataset.confirm);" data-confirm="{{ trans('tpv-confirm-copy-cost') }}">
                <i class="fa-solid fa-file-invoice-dollar me-1" aria-hidden="true"></i>{{ trans('tpv-copy-cost') }}
            </button>
            <span class="small text-muted">{{ trans('tpv-copy-cost-help') }}</span>
        </div>
    {% endif %}
    <p class="small text-muted mb-0 mt-2">{{ trans('tpv-cost-help') }}</p>
    <p class="small text-muted mb-0">{{ trans('tpv-recipe-cache-help') }}</p>
{% endif %}
