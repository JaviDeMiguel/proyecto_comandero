<?xml version="1.0" encoding="UTF-8"?>
<!--
 * Plugin Hosteleria: destino de impresión de la comanda (familias.tpv_destino).
 * Vacío = hereda de la familia madre (y, si nadie lo define, el destino por defecto del TPV).
 * Extension/Controller/EditFamilia cambia el texto de la opción vacía por "Heredar".
-->
<view>
    <columns>
        <group name="data">
            <column name="tpv-destination" title="tpv-destination" description="tpv-destination-desc" numcolumns="3" order="140">
                <widget type="select" fieldname="tpv_destino" translate="true" icon="fa-solid fa-utensils">
                    <values title="tpv-kitchen">cocina</values>
                    <values title="tpv-bar">barra</values>
                </widget>
            </column>
            <column name="tpv-destination-effective" title="tpv-destination-effective" numcolumns="3" order="150">
                <widget type="text" fieldname="tpv_destino_efectivo" readonly="true"/>
            </column>
        </group>
    </columns>
</view>
